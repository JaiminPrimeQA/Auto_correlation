          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Print Correlated Values" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">log.info('==================== CORRELATED VALUES (runtime) ====================')
vars.entrySet().sort { it.key }.each { e -&gt;
    def k = e.key
    if (!k.startsWith('__') &amp;&amp; !k.startsWith('JMeterThread') &amp;&amp; k != 'START.MS' &amp;&amp; k != 'START.YMD' &amp;&amp; k != 'START.HMS' &amp;&amp; k != 'TESTSTART.MS' &amp;&amp; k != 'THREAD.NAME') {
        log.info(String.format('  %-14s = %s', k, e.value))
    }
}
log.info('====================================================================')
def dump = new StringBuilder('Correlated values:\n')
vars.entrySet().sort { it.key }.each { e -&gt;
    if (!e.key.startsWith('__') &amp;&amp; !e.key.startsWith('JMeterThread')) dump.append(e.key).append(' = ').append(e.value).append('\n')
}
SampleResult.setResponseData(dump.toString(), 'UTF-8')
SampleResult.setDataType('text')
</stringProp>
          </JSR223Sampler>
