# URL of the FastAPI backend the Next.js dev server proxies /api/* to.
BACKEND_URL=http://127.0.0.1:8000

# Optional OIDC sign-in (Authorization Code + PKCE). Leave empty for local
# development without sign-in (backend B11_AUTH_MODE=disabled).
# Register redirect URI <origin>/auth/callback with your identity provider.
NEXT_PUBLIC_OIDC_AUTHORITY=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_SCOPE=openid profile email
# Only for providers that need an API audience parameter (e.g. Auth0).
NEXT_PUBLIC_OIDC_AUDIENCE=
