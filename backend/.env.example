# Baseline11 Auto-Correlate — backend configuration (safe placeholders).
# Copy to `.env` and adjust. All variables are prefixed with B11_.

B11_ENVIRONMENT=development
B11_API_PREFIX=/api/v1

# CORS: comma-separated origins. Wildcard is rejected in production.
B11_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload / parsing limits
B11_MAX_FILE_BYTES=26214400          # 25 MiB
B11_MAX_FILES=2
B11_MAX_JSON_DEPTH=64
B11_MAX_ARRAY_LENGTH=200000
B11_MAX_SCALAR_LENGTH=200000
B11_MAX_TOTAL_VALUES=2000000

# Ephemeral session store
B11_SESSION_TTL_SECONDS=1800         # 30 minutes
B11_SESSION_STORE=memory             # memory | redis
# B11_REDIS_URL=redis://localhost:6379/0

# Rate limiting
B11_RATE_LIMIT_ENABLED=true
B11_RATE_LIMIT_REQUESTS=60
B11_RATE_LIMIT_WINDOW_SECONDS=60

# Correlation / health thresholds
B11_AUTH_FAILURE_BLOCK_RATIO=0.30
B11_MIN_ALIGNMENT_COVERAGE=0.80
B11_SERVER_ERROR_WARN_RATIO=0.30
B11_MIN_DYNAMIC_VALUE_LENGTH=4
B11_TOKEN_ENTROPY_HINT=2.5

# --- Accounts, plans and billing ---
# SQLite database and saved history files (created on first start).
B11_DATABASE_PATH=data/baseline11.db
B11_HISTORY_DIR=data/history
# Sign-in is required before any analysis, so every use is counted per account.
B11_REQUIRE_ACCOUNT=true
# Free allowance: analyses per account (and per browser), and the per-file limit.
B11_FREE_USES=3
B11_FREE_MAX_FILE_MB=2
# Also count per client IP (everyone behind one shared IP shares the allowance).
B11_FREE_TIER_COUNT_BY_IP=false
# Proxies in front of the API that append X-Forwarded-For (Next.js dev proxy = 1).
B11_TRUSTED_PROXY_HOPS=1
# Prices are in cents.
B11_PLAN_CURRENCY=USD
B11_PLAN_MONTHLY_PRICE_CENTS=900
B11_PLAN_SEMIANNUAL_PRICE_CENTS=4500
B11_PLAN_YEARLY_PRICE_CENTS=7900
B11_PLAN_MONTHLY_MAX_FILE_MB=50
B11_PLAN_SEMIANNUAL_MAX_FILE_MB=100
B11_PLAN_YEARLY_MAX_FILE_MB=200
B11_PLAN_MONTHLY_RETENTION_DAYS=7
B11_PLAN_SEMIANNUAL_RETENTION_DAYS=30
B11_PLAN_YEARLY_RETENTION_DAYS=90
# demo = plans activate without payment (refused in production) | disabled
B11_BILLING_PROVIDER=demo
B11_APP_BASE_URL=http://localhost:3000

# --- Email (SMTP) ---
# Leave B11_SMTP_HOST empty to only log emails. For Gmail use an App Password.
B11_SMTP_HOST=
B11_SMTP_PORT=587
B11_SMTP_SECURITY=starttls
B11_SMTP_USERNAME=
B11_SMTP_PASSWORD=
B11_MAIL_FROM_ADDRESS=
B11_MAIL_FROM_NAME=Baseline Auto Correlation
B11_EXPIRY_REMINDER_DAYS=3
